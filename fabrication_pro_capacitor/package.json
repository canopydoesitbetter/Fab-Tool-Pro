{
  "name": "fabrication-pro-capacitor",
  "version": "1.0.0",
  "private": true,
  "description": "Native Capacitor wrapper for the Fabrication Pro offline fabrication shop application.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "native:init": "node scripts/native-init.mjs",
    "sync": "npx cap sync",
    "copy": "npx cap copy",
    "android:add": "npx cap add android",
    "ios:add": "npx cap add ios",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "android:run": "npx cap run android",
    "ios:run": "npx cap run ios",
    "doctor": "npx cap doctor",
    "verify:web": "node scripts/verify-web.mjs",
    "verify:native-shim": "node scripts/verify-native-shim.mjs",
    "verify": "npm run verify:web && npm run verify:native-shim && npm run verify:ios-privacy && npm run verify:android-signing",
    "verify:ios-privacy": "node scripts/verify-ios-privacy.mjs",
    "verify:android-signing": "node scripts/verify-android-signing.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.0",
    "@capacitor/share": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0"
  }
}
